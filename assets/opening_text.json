      "group": "opening.prologue",
      "entries": [
        {
          "id": "C7:B480+09F9",
          "source": "darkness sweeps the"
        },
        {
          "id": "C7:B480+0A10",
          "source": "troubled land, as mana's"
        },
        {
          "id": "C7:B480+0A2C",
          "source": "power fades..."
        },
        {
          "id": "C7:B480+0A3E",
          "source": "people await a hero who"
        },
        {
          "id": "C7:B480+0A59",
          "source": "will wield the sword..."
        },
        {
          "id": "C7:B480+0A74",
          "source": "excalibur, herald, gigas..."
        },
        {
          "id": "C7:B480+0A93",
          "source": "the blade has had many"
        },
        {
          "id": "C7:B480+0AAD",
          "source": "names, for it has been"
        },
        {
          "id": "C7:B480+0AC7",
          "source": "celebrated in myths and"
        },
        {
          "id": "C7:B480+0AE2",
          "source": "legends throughout time."
        },
        {
          "id": "C7:B480+0AFE",
          "source": "but all of these speak to"
        },
        {
          "id": "C7:B480+0B1B",
          "source": "just one weapon:"
        },
        {
          "id": "C7:B480+0B2F",
          "source": "the sword of mana."
        }
      ]
    },
