    {
      "group": "resources.magic_description",
      "entries": [
        {
          "id": "CA:AE9C",
          "text": "      Un rocher écrase la cible"
        },
        {
          "id": "CA:AEBC",
          "text": "      Une pluie de diamants s'abat sur\n      la cible"
        },
        {
          "id": "CA:AEE0",
          "text": "      Des lianes ralentissent les \n      déplacements de la cible"
        },
        {
          "id": "CA:AF03",
          "text": "      Confère à une arme le pouvoir de\n      pétrifier"
        },
        {
          "id": "CA:AF28",
          "text": "      Augmente l'esquive et accélère\n      les attaques"
        },
        {
          "id": "CA:AF4C",
          "text": "      Augmente la défense et réduit les\n      dégâts subis"
        },
        {
          "id": "CA:AF6F",
          "text": "      Un blizzard glacial frappe la cible"
        },
        {
          "id": "CA:AF8E",
          "text": "      Une violente pluie acide réduit\n      la défense de la cible"
        },
        {
          "id": "CA:AFB2",
          "text": "      Vole des points de vie à la cible"
        },
        {
          "id": "CA:AFCB",
          "text": "      Confère à une arme le pouvoir de\n      l'eau"
        },
        {
          "id": "CA:AFEE",
          "text": "      Guérit les altérations d'état"
        },
        {
          "id": "CA:B001",
          "text": "      Restitue des points de vie"
        },
        {
          "id": "CA:B010",
          "text": "      Des boules de feu s'abattent sur\n      la cible"
        },
        {
          "id": "CA:B02E",
          "text": "      Des explosions brûlent la cible"
        },
        {
          "id": "CA:B050",
          "text": "      De la lave engloutit la cible"
        },
        {
          "id": "CA:B06D",
          "text": "      Confère à une arme le pouvoir du\n      feu"
        },
        {
          "id": "CA:B08F",
          "text": "      Brûle la cible et affaiblit ses\n      attaques"
        },
        {
          "id": "CA:B0B3",
          "text": "      Un mur de feu s'abat sur la cible\n      et l'embrase"
        },
        {
          "id": "CA:B0D9",
          "text": "      Des rafales de vent lacèrent\n      la cible"
        },
        {
          "id": "CA:B0FA",
          "text": "      Un puissant éclair frappe la cible"
        },
        {
          "id": "CA:B120",
          "text": "      Plonge la cible dans un état\n      de confusion"
        },
        {
          "id": "CA:B138",
          "text": "      Confère à une arme le pouvoir du\n      vent"
        },
        {
          "id": "CA:B15A",
          "text": "      Immobilise la cible avec un ballon"
        },
        {
          "id": "CA:B17C",
          "text": "      Analyse la cible et désamorce\n      les pièges des coffres"
        },
        {
          "id": "CA:B1A0",
          "text": "      Transforme l'ennemi en un monstre \n      de bas niveau"
        },
        {
          "id": "CA:B1C4",
          "text": "      Vole des points de magie à \n      la cible"
        },
        {
          "id": "CA:B1D8",
          "text": "      Effet surprise sur les ennemis et\n      l'équipe !"
        },
        {
          "id": "CA:B1FD",
          "text": "      Confère à une arme le pouvoir\n      d'absorber des PV"
        },
        {
          "id": "CA:B222",
          "text": "      Augmente l'attaque de l'équipe\n      grâce au pouvoir de la lune"
        },
        {
          "id": "CA:B239",
          "text": "      Augmente le taux de coups\n      critiques"
        },
        {
          "id": "CA:B252",
          "text": "      Plonge la cible dans un doux\n      sommeil"
        },
        {
          "id": "CA:B26C",
          "text": "      La cible se consume de l'intérieur"
        },
        {
          "id": "CA:B28D",
          "text": "      Effet secret"
        },
        {
          "id": "CA:B296",
          "text": "      Chasse la Faucheuse et ranime\n      un ami"
        },
        {
          "id": "CA:B2B2",
          "text": "      Crée une barrière qui renvoie les\n      sorts ennemis"
        },
        {
          "id": "CA:B2D7",
          "text": "      Effet secret"
        },
        {
          "id": "CA:B2E0",
          "text": "      Une vague d'obscurité enveloppe\n      la cible"
        },
        {
          "id": "CA:B305",
          "text": "      Des boules d'énergie noire\n      frappent la cible"
        },
        {
          "id": "CA:B320",
          "text": "      Dissipe les sorts d'amélioration et\n      réduit la jauge d'énergie à 0"
        },
        {
          "id": "CA:B347",
          "text": "      Confère à une arme le pouvoir de\n      la lumière"
        },
        {
          "id": "CA:B36A",
          "text": "      Une lumière sacrée transperce\n      la cible"
