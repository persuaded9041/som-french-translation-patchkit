  "groups": [
    {
      "group": "game_select.welcome",
      "entries": [
        {
          "id": "C0:33F0",
          "text": "Bienvenue dans Secret of Mana."
        },
        {
          "id": "C0:340C",
          "text": "Choisissez \"Nouveau\" pour commencer une nouvelle partie."
        },
        {
          "id": "C0:343B",
          "text": "Choisissez \"Continuer\" pour reprendre une partie."
        },
        {
          "id": "C0:3472",
          "text": "Appuyez sur le bouton B pour commencer."
        }
      ]
    },
    {
      "group": "game_file.save_help",
      "entries": [
        {
          "id": "C0:348D",
          "text": "Sauvegarder sur un fichier utilisé efface ses données."
        },
        {
          "id": "C0:34BE",
          "text": "Appuyez sur “Attaque” pour sauver, “Retour” pour annuler."
        }
      ]
    },
    {
      "group": "window_settings.help",
      "entries": [
        {
          "id": "C0:34F9",
          "text": "Choisissez le fond : gauche/droite, bordure : haut/bas."
        },
        {
          "id": "C0:3521",
          "text": "Réglez la couleur : maintenez A, Y ou X et gauche/droite."
        },
        {
          "id": "C0:3550",
          "text": "Appuyez sur B pour valider, Select pour annuler."
        }
      ]
    },
    {
      "group": "name_entry.help",
      "entries": [
        {
          "id": "C0:3584",
          "text": "Choisissez un caractère avec la croix directionnelle."
        },
        {
          "id": "C0:35BF",
          "text": "Appuyez sur B pour valider. Le nom peut faire"
        },
        {
          "id": "C0:35FB",
          "text": "9 lettres maximum. Appuyez sur Start pour continuer."
        }
      ]
    },
    {
      "group": "action_settings.help",
      "entries": [
        {
          "id": "C0:3620",
          "text": "Choisissez le type d'action. Validez avec “Attaque”."
        },
        {
          "id": "C0:3654",
          "text": "Jusqu'où charger la jauge ? Validez avec “Attaque”."
        }
      ]
    },
